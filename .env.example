GATEWAY_API_KEY=dev-gateway-key
REQUEST_TIMEOUT_SECONDS=60

# Provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Provider endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Stable alias -> provider:model
MODEL_ALIASES_JSON={"default":"mock:demo"}

# Logical pool -> ordered provider:model candidates
MODEL_POOLS_JSON={"balanced":["mock:demo"]}

# Ordered global fallback candidates
FALLBACK_MODELS_JSON=[]

# Pricing per 1M tokens
MODEL_PRICING_JSON={"mock:demo":{"input_per_million":0.0,"output_per_million":0.0}}

# priority | round_robin | random | cost
ROUTING_POLICY=priority

# Resilience / governance
PROVIDER_RETRY_ATTEMPTS=1
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30

# Optional hard budgets
# DAILY_BUDGET_USD=10
# MONTHLY_BUDGET_USD=100

# v0.3 distributed state
# auto = Redis when REDIS_URL is set, otherwise memory
STATE_BACKEND=auto
REDIS_URL=
REDIS_PREFIX=llm-gateway

# v0.3 OpenTelemetry
OTEL_SERVICE_NAME=multi-llm-ai-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# Docker Compose demo only
GRAFANA_ADMIN_PASSWORD=admin
